{
  "manifest_version": 3,
  "name": "Review Desk — 画面から修正依頼へ",
  "description": "画面を指定し、メモ・判断・修正前後を端末に記録。人やAIへ渡せる修正依頼を書き出します。",
  "version": "1.1.0.3",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Review Desk",
    "default_popup": "popup.html"
  },
  "options_page": "desk.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "version_name": "1.1.0-beta.3"
}
